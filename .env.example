# Copie para .env.local; não versionar os valores de produção.
DATABASE_URL=postgresql://cubo_pe:SUBSTITUA_POR_UMA_SENHA@localhost:5432/cubo_pe
APP_URL=http://localhost:3000
# Nome público inicial; conteúdo salvo no painel pode substituí-lo.
COMMUNITY_NAME=Comunidade Pernambucana de Cubo Mágico
NODE_ENV=development

# E-mail transacional (Resend). Sem RESEND_API_KEY e MAIL_FROM, confirmação,
# recuperação de senha e avisos ficam indisponíveis e nada é enviado.
RESEND_API_KEY=
MAIL_FROM=

# Login WCA (OAuth). Sem as duas credenciais, o login WCA fica desativado.
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=

# Armazenamento de mídia (fotos e vídeos privados). Padrão: .data/media.
# No container, o compose já define /app/.data/media com volume persistente.
MEDIA_STORAGE_DIR=.data/media
